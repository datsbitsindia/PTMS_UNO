<%- include('partials/head',{title:'Dashboard'}) %>
<%- include('partials/nav',{page:'dashboard'}) %>

<% if (user.role === 'manager' || user.role === 'admin') { %>
    <div class="metric-grid dashboard-kpis four-by-two">
        <a href="/projects" class="metric-card" onclick="filterByKpi('all', event)"><i class="fa-solid fa-folder-open"></i><b><%= stats.totalProjects || (typeof projects !== 'undefined' ? projects.length : 0) %></b><span>Total Projects</span></a>
        <a href="/projects?status=In+Progress" class="metric-card orange" onclick="filterByKpi('Pending', event)"><i class="fa-regular fa-folder"></i><b><%= stats.pendingProjects || 0 %></b><span>Pending Projects</span></a>
        <a href="/tasks" class="metric-card"><i class="fa-solid fa-list-check"></i><b><%= stats.total %></b><span>Total Tasks</span></a>
        <a href="/tasks?status=Pending" class="metric-card orange"><i class="fa-regular fa-clock"></i><b><%= stats.pending %></b><span>Pending Tasks</span></a>
        
        <a href="/tasks?status=In+Progress" class="metric-card purple"><i class="fa-solid fa-spinner"></i><b><%= stats.inProgress %></b><span>In Progress Tasks</span></a>
        <a href="/tasks?status=Completed" class="metric-card green"><i class="fa-solid fa-circle-check"></i><b><%= stats.completed %></b><span>Completed Tasks</span></a>
        <a href="/tasks?status=Overdue" class="metric-card red"><i class="fa-solid fa-triangle-exclamation"></i><b><%= stats.overdue %></b><span>Overdue Tasks</span></a>
        <% if (employees !== null) { %>
            <a href="/employees" class="metric-card purple"><i class="fa-solid fa-users"></i><b><%= employees %></b><span>Employees</span></a>
        <% } else { %>
            <a href="/tasks?status=Planned" class="metric-card"><i class="fa-solid fa-calendar-day"></i><b><%= stats.total - stats.completed %></b><span>Active Tasks</span></a>
        <% } %>
    </div>
<% } else { %>
    <div class="metric-grid dashboard-kpis employee-kpis four">
        <a href="/tasks" class="metric-card"><i class="fa-solid fa-list-check"></i><b><%= stats.total %></b><span>Total Tasks</span></a>
        <a href="/tasks?status=Pending" class="metric-card orange"><i class="fa-regular fa-clock"></i><b><%= stats.pending %></b><span>Pending Tasks</span></a>
        <a href="/tasks?status=In+Progress" class="metric-card purple"><i class="fa-solid fa-spinner"></i><b><%= stats.inProgress %></b><span>In Progress Tasks</span></a>
        <a href="/tasks?status=Completed" class="metric-card green"><i class="fa-solid fa-circle-check"></i><b><%= stats.completed %></b><span>Completed Tasks</span></a>
    </div>
<% } %>

<% if (user.role === 'employee') { %>
    <section class="ui-panel">
        <div class="ui-panel-head">
            <h2>My Assigned Tasks</h2>
            <a href="/tasks" class="btn link-btn">View all tasks</a>
        </div>
        <div class="entity-list">
            <% (typeof tasks !== 'undefined' ? tasks : []).forEach(t => { %>
                <article class="entity-card dashboard-task-card" data-status="<%= t.status %>" onclick="window.location.href='/tasks/<%= t.id %>'" style="cursor:pointer; background:#ffffff; border:1px solid #d8e2f0; border-left:4px solid #3b68b7; border-radius:14px; padding:12px 14px; margin-bottom:10px; box-shadow:0 4px 12px rgba(15,23,42,0.03);">
                    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:8px;">
                        <div>
                            <b style="font-size:15px; color:#0f172a; display:block; line-height:1.2;"><%= t.title %></b>
                            <small style="color:#64748b; font-size:11px; display:block; margin-top:2px;">
                                <%= t.project_name || 'Project' %><% if(t.description){ %> · <%= t.description %><% } %>
                            </small>
                        </div>
                        <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                            <span class="priority-pill <%= t.priority.toLowerCase() %>" style="font-size:10px; padding:3px 8px; border-radius:99px; font-weight:700;">
                                <i class="fa-solid fa-flag"></i> <%= t.priority %>
                            </span>
                            <% if (t.is_forwarded) { %>
                                <span class="status-chip forwarded" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-size:10px; padding:3px 8px; border-radius:99px;">
                                    <i class="fa-solid fa-share"></i> Forwarded
                                </span>
                            <% } %>
                            <span class="status-chip <%= t.status.toLowerCase().replaceAll(' ', '-') %>" style="font-size:10px; padding:3px 8px; border-radius:99px;">
                                <%= t.status %>
                            </span>
                        </div>
                    </div>
                    
                    <div style="display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:8px; padding-top:6px; border-top:1px solid #f1f5f9;">
                        <div>
                            <small style="display:block; font-size:9px; text-transform:uppercase; color:#64748b; font-weight:700; letter-spacing:0.04em;">ASSIGNED BY</small>
                            <b style="font-size:12px; color:#0f172a; margin-top:1px; display:block;"><%= t.creator_name || 'Bhavin' %></b>
                        </div>
                        <div>
                            <small style="display:block; font-size:9px; text-transform:uppercase; color:#64748b; font-weight:700; letter-spacing:0.04em;">ASSIGNED ON</small>
                            <b style="font-size:12px; color:#0f172a; margin-top:1px; display:block;"><%= formatDate(t.created_at) %></b>
                        </div>
                        <div>
                            <small style="display:block; font-size:9px; text-transform:uppercase; color:#64748b; font-weight:700; letter-spacing:0.04em;">DUE DATE</small>
                            <b style="font-size:12px; color:#0f172a; margin-top:1px; display:block;"><%= formatDate(t.due_date) %></b>
                        </div>
                    </div>
                </article>
            <% }) %>
            <% if (typeof tasks === 'undefined' || !tasks.length) { %>
                <p class="empty">No tasks assigned yet.</p>
            <% } %>
        </div>
    </section>
<% } else { %>
    <section class="ui-panel">
        <div class="ui-panel-head">
            <h2><%= user.role === 'admin' ? 'All Projects' : 'My Projects' %></h2>
            <% if (user.role === 'manager') { %>
                <a href="/reports" class="btn primary btn-sm">
                    <i class="fa-solid fa-chart-column"></i> View Reports
                </a>
            <% } %>
        </div>
        <div class="entity-list">
            <% (typeof projects !== 'undefined' ? projects : []).forEach(p => { %>
                <article class="entity-card project-card <%= p.is_overdue ? 'overdue-card' : '' %>" data-status="<%= p.status %>" onclick="window.location.href='/projects/<%= p.id %>'" style="cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:12px 16px; gap:12px; grid-template-columns:none!important;">
                    <div class="entity-title" style="flex:1; min-width:0;">
                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom: 2px;">
                            <a href="/projects/<%= p.id %>" style="font-weight:800; font-size:15px; color:#0f172a; text-decoration:none;" onclick="event.stopPropagation();"><%= p.name %></a>
                            <span class="status-chip <%= p.is_overdue ? 'overdue' : String(p.status).toLowerCase().replaceAll(' ', '-') %>">
                                <%= p.is_overdue ? 'Overdue' : p.status %>
                            </span>
                        </div>
                        <small style="color:#64748b; font-size:11px;">Managed by <b><%= p.manager_name %></b> · <%= p.task_count || 0 %> task<%= p.task_count === 1 ? '' : 's' %></small>
                        <div class="project-inline-dates" style="display:flex; align-items:center; gap:12px; margin-top:4px; font-size:11px; color:#475569; flex-wrap:wrap;">
                            <span><i class="fa-regular fa-calendar" style="color:#6366f1;"></i> <b>Start:</b> <%= formatDate(p.start_date) %></span>
                            <span><i class="fa-regular fa-calendar-check" style="color:#16a34a;"></i> <b>Due:</b> <%= formatDate(p.end_date) %></span>
                        </div>
                    </div>
                    <a class="entity-action open-project-btn" href="/projects/<%= p.id %>" onclick="event.stopPropagation();" style="display:inline-flex; align-items:center; gap:6px; padding:6px 12px; width:auto; height:32px; border-radius:8px; background:#d3e3fd; color:#0b2d68; font-size:12px; font-weight:700; text-decoration:none; white-space:nowrap; flex-shrink:0;">
                        View Project <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </article>
            <% }) %>
            <% if (typeof projects === 'undefined' || !projects.length) { %>
                <p class="empty">No projects assigned yet.</p>
            <% } %>
        </div>
    </section>
<% } %>

<%- include('partials/foot') %>


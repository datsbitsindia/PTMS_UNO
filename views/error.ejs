<%- include('partials/head',{title:'Error'}) %>
<% const currentUser = (typeof user !== 'undefined' && user) ? user : null; %>
<% if (currentUser) { %>
    <%- include('partials/nav',{page:''}) %>
<% } else { %>
    <main class="standalone">
<% } %>
<div class="error-box">
    <i class="fa-solid fa-circle-exclamation"></i>
    <h1>Something went wrong</h1>
    <p><%= message %></p>
    <a class="btn primary" href="<%= currentUser ? '/dashboard' : '/login' %>">Go back</a>
</div>
<% if (currentUser) { %>
    <%- include('partials/foot') %>
<% } else { %>
    </main></div></body></html>
<% } %>

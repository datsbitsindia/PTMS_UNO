<%- include('partials/head', { title: 'My Private Notes - Task Manager' }) %>
<%- include('partials/nav') %>

<style>
.notes-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
}

.notes-page-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 10px;
}

.notes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.note-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 12px 8px 16px;
    transition: all 0.2s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    position: relative;
    overflow: hidden;
}

.note-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #6366f1;
    border-radius: 4px 0 0 4px;
}

.note-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.12);
    border-color: #c7d2fe;
}

.note-card-title {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.note-card-snippet {
    font-size: 12px;
    color: #64748b;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    margin-bottom: 4px;
}

.note-card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    font-size: 10px;
    color: #94a3b8;
}

.empty-notes-box {
    background: #ffffff;
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    padding: 50px 20px;
    text-align: center;
    color: #64748b;
}
</style>

<div class="notes-page-header">
    <h2>
        <i class="fa-solid fa-sticky-note" style="color:#6366f1;"></i> My Private Notes
        <span style="font-size:12px; font-weight:600; background:#e0e7ff; color:#4338ca; padding:3px 10px; border-radius:99px;">
            <%= notes.length %> <%= notes.length === 1 ? 'Note' : 'Notes' %>
        </span>
    </h2>
    <form action="/notes/create" method="post" style="margin:0;">
        <button type="submit" class="btn primary" style="font-weight:700; border-radius:10px; padding:8px 16px; display:inline-flex; align-items:center; gap:8px;">
            <i class="fa-solid fa-plus"></i> New Note
        </button>
    </form>
</div>

<% if (notes && notes.length > 0) { %>
    <div class="notes-grid">
        <% notes.forEach(n => { %>
            <a href="/notes/<%= n.id %>" class="note-card">
                <div class="note-card-title"><%= n.title || 'Untitled Note' %></div>
                <div class="note-card-snippet"><%= n.details ? n.details.replace(/<[^>]*>?/gm, '').substring(0, 100) : 'Empty note...' %></div>
                <div class="note-card-footer">
                    <span><i class="fa-regular fa-clock"></i> <%= formatDateTime(n.updated_at) %></span>
                </div>
            </a>
        <% }) %>
    </div>
<% } else { %>
    <div class="empty-notes-box">
        <i class="fa-solid fa-note-sticky" style="font-size:54px; color:#cbd5e1; margin-bottom:16px;"></i>
        <h3 style="margin:0 0 8px; color:#1e293b;">No notes found</h3>
        <p style="margin:0 0 20px; font-size:14px; color:#64748b;">Create your first private note to keep track of your personal tasks, ideas, and reminders.</p>
        <form action="/notes/create" method="post" style="margin:0; display:inline-block;">
            <button type="submit" class="btn primary" style="font-weight:700; border-radius:10px;">
                <i class="fa-solid fa-plus"></i> Create Note Now
            </button>
        </form>
    </div>
<% } %>

<%- include('partials/foot') %>

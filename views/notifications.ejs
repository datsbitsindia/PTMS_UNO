<%- include('partials/head',{title:'Notifications'}) %><%- include('partials/nav',{page:'notifications'}) %><section class="panel notification-list"><% notes.forEach(n=>{ %><a href="<%= n.link||'#' %>"><i class="fa-solid fa-bell"></i><div><b><%= n.message %></b><small><%= formatDateTime(n.created_at) %></small></div></a><% }) %><% if(!notes.length){ %><p class="empty">You have no notifications.</p><% } %></section><%- include('partials/foot') %>

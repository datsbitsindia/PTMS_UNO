<!-- AI Chat Floating Button -->
<button type="button" class="ai-fab" id="ai-chat-toggle" title="Task Assistant">
    <i class="fa-solid fa-wand-magic-sparkles"></i>
</button>

<!-- AI Chat Drawer -->
<div class="ai-chat-drawer" id="ai-chat-drawer">
    <div class="ai-chat-header">
        <div class="ai-chat-title">
            <i class="fa-solid fa-robot"></i>
            <span>Task Manager AI</span>
        </div>
        <div class="ai-chat-actions">
            <button type="button" class="ai-chat-clear" id="ai-chat-clear" title="Start New Chat"><i class="fa-solid fa-plus"></i> New Chat</button>
            <button type="button" class="ai-chat-close" id="ai-chat-close">&times;</button>
        </div>
    </div>

    <div class="ai-chat-body" id="ai-chat-body">
        <div class="ai-msg bot">
            👋 Namaste! Main aapka AI Task Assistant hoon. Main aapke tasks search, create, ya summarize kar sakta hoon. Bolie kya madad karun?
        </div>
    </div>

    <form class="ai-chat-footer" id="ai-chat-form">
        <textarea class="ai-chat-input" id="ai-chat-input" rows="1" placeholder="Type or speak a message..." autocomplete="off" required></textarea>
        <button type="button" class="ai-mic-btn" id="ai-mic-btn" title="Voice Input (Speech-to-Text)">
            <i class="fa-solid fa-microphone"></i>
        </button>
        <button type="submit" class="ai-send-btn" title="Send Message">
            <i class="fa-solid fa-paper-plane"></i>
        </button>
    </form>
</div>


<!-- PWA Install Guide Modal -->
<div class="modal" id="pwa-guide-modal">
    <div class="modal-card" style="max-width:420px; text-align:center;">
        <button class="modal-close" data-close>&times;</button>
        <div style="width:54px; height:54px; background:#edf2fa; color:#3b68b7; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:24px; margin-bottom:12px; margin-left:auto; margin-right:auto;">
            <i class="fa-solid fa-mobile-screen-button"></i>
        </div>
        <h2 style="font-size:18px; color:#0f172a; margin-bottom:6px;">Install TaskManager App</h2>
        <p style="font-size:13px; color:#64748b; margin-bottom:16px;">Access TaskManager directly from your phone Home Screen!</p>
        
        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:14px; text-align:left; font-size:13px; color:#334155; margin-bottom:16px; line-height:1.5;">
            <div style="margin-bottom:12px;">
                <b style="color:#0f172a;"><i class="fa-brands fa-android" style="color:#16a34a;"></i> On Android (Chrome / Edge):</b>
                <div style="margin-top:3px; color:#475569;">1. Tap Chrome Menu <b>(⋮)</b> at top right</div>
                <div style="color:#475569;">2. Select <b>"Install app"</b> or <b>"Add to Home screen"</b></div>
            </div>
            <div>
                <b style="color:#0f172a;"><i class="fa-brands fa-apple" style="color:#000000;"></i> On iPhone / iPad (Safari):</b>
                <div style="margin-top:3px; color:#475569;">1. Tap Share button <b>( 📤 )</b> at bottom</div>
                <div style="color:#475569;">2. Select <b>"Add to Home Screen"</b></div>
            </div>
        </div>

        <button type="button" class="btn primary wide" data-close style="background:#3b68b7;">Got It!</button>
    </div>
</div>

<!-- Custom In-App Confirmation Modal -->
<div class="modal confirm-modal" id="global-confirm-modal">
    <div class="modal-card confirm-modal-card">
        <button class="modal-close" data-close>&times;</button>
        <div class="confirm-modal-icon danger" id="confirm-modal-icon">
            <i class="fa-solid fa-trash-can" id="confirm-modal-icon-i"></i>
        </div>
        <h3 class="confirm-modal-title" id="confirm-modal-title">Confirm Action</h3>
        <p class="confirm-modal-message" id="confirm-modal-message">Are you sure you want to proceed?</p>
        <div class="confirm-modal-actions">
            <button type="button" class="btn btn-cancel" id="confirm-modal-cancel-btn">Cancel</button>
            <button type="button" class="btn btn-confirm-danger" id="confirm-modal-ok-btn">Yes, Delete</button>
        </div>
    </div>
</div>

</main></section></div><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script src="/js/app.js?v=13"></script><%- include('ai-chat') %><script src="/js/ai-chat.js"></script></body></html>

<% if (user && typeof projects !== 'undefined') { %>

    <div class="modal" id="task-modal">

        <div class="modal-card">

            <!-- Modal Header Tabs -->
            <% if (user.role === 'manager' || user.role === 'admin') { %>

            <div class="modal-header-tabs">
                <div class="modal-tabs">
                    <button type="button" class="modal-tab active" data-tab="single-task-tab">
                        <i class="fa-solid fa-list-check"></i> Regular Task
                    </button>
                    <button type="button" class="modal-tab" data-tab="routine-tab">
                        <i class="fa-solid fa-repeat"></i> Daily Routine
                    </button>
                </div>
                <button class="modal-close" data-close>&times;</button>
            </div>
            <% } else { %>
            <div class="modal-header-tabs">
                <h2 style="margin:0; font-size:16px;"><i class="fa-solid fa-plus"></i> Add Task</h2>
                <button class="modal-close" data-close>&times;</button>
            </div>
            <% } %>

            <!-- Single Regular Task Form -->
            <div class="modal-tab-content active" id="single-task-tab">

                <form
                    action="/tasks/save"
                    method="POST"
                    class="form-grid"
                    id="single-task-form"
                >
                    <input type="hidden" name="id" id="task-id-input">

                    <label class="full">
                        Project
                        <select name="project_id">
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>" <%= p.name === 'Self Task' ? 'selected' : '' %>>
                                    <%= p.name %>
                                </option>
                            <% }) %>
                            <option value="">Normal Task (No Project)</option>
                        </select>
                    </label>

                    <label class="full">
                        Task title
                        <input
                            name="title"
                            placeholder="Enter task title..."
                            required
                        >
                    </label>

                    <label class="full">
                        <span>Description</span>
                        <textarea
                            name="description"
                            class="ck-editor-target"
                            rows="3"
                        ></textarea>
                    </label>

                    <% if (typeof employees !== 'undefined' || typeof managers !== 'undefined') { %>
                    <label class="full">
                        <span>Assignees / Team Members (Select Multiple)</span>
                        <div class="multi-assignee-picker">
                            <div class="assignees-chips-list" id="single-task-assignee-chips"></div>
                            <select class="assignee-select-dropdown" onchange="addAssigneeChip(this, 'single-task-assignee-chips')">
                                <option value="">+ Select Employee or Manager to add...</option>
                                <option value="<%= user.id %>" data-name="<%= user.name %> (Self)" data-role="Self">Assign to Myself (Self Task)</option>
                                <% if (typeof employees !== 'undefined' && employees.length) { %>
                                    <optgroup label="Employees">
                                        <% employees.forEach(e => { %>
                                            <option value="<%= e.id %>" data-name="<%= e.name %>" data-role="Employee"><%= e.name %> (<%= e.designation || 'Employee' %>)</option>
                                        <% }) %>
                                    </optgroup>
                                <% } %>
                                <% if (typeof managers !== 'undefined' && managers.length) { %>
                                    <optgroup label="Managers">
                                        <% managers.filter(m => m.id !== user.id).forEach(m => { %>
                                            <option value="<%= m.id %>" data-name="<%= m.name %>" data-role="Manager"><%= m.name %> (<%= m.designation || 'Manager' %>)</option>
                                        <% }) %>
                                    </optgroup>
                                <% } %>
                            </select>
                        </div>
                    </label>
                    <% } else { %>
                        <input type="hidden" name="assigned_to" value="<%= user.id %>">
                    <% } %>

                    <label>
                        Priority
                        <select name="priority">
                            <% ['Low','Medium','High','Critical'].forEach(x=>{ %>
                                <option <%= x === 'Medium' ? 'selected' : '' %>><%= x %></option>
                            <% }) %>
                        </select>
                    </label>

                    <label>
                        Estimated Hours
                        <input type="number" name="estimated_hours" min="0" step="0.5" placeholder="e.g. 2.5">
                    </label>

                    <label>
                        Due date
                        <input type="date" name="due_date" required>
                    </label>

                    <div class="full actions" style="margin-top: 1rem;">
                        <button type="button" class="btn" data-close>
                            Cancel
                        </button>
                        <button class="btn primary">
                            <i class="fa-solid fa-plus"></i> Create Task
                        </button>
                    </div>

                </form>

            </div>

            <!-- Routine Task Form (For Manager) -->
            <% if (user.role === 'manager') { %>
            <div class="modal-tab-content" id="routine-tab">

                <h2><i class="fa-solid fa-repeat" style="color: #4f46e5;"></i> Create Daily Routine Task</h2>
                <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">Automate daily repetitive tasks for your team.</p>

                <form action="/tasks/routine/save" method="POST" class="form-grid">

                    <label class="full">
                        Project
                        <select name="project_id" required>
                            <option value="">Select Project</option>
                            <% projects.forEach(p => { %>
                                <option value="<%= p.id %>">
                                    <%= p.name %>
                                </option>
                            <% }) %>
                        </select>
                    </label>

                    <label class="full">
                        Assignee
                        <select name="assigned_to" required>
                            <option value="">Select Employee</option>
                            <% (typeof employees !== 'undefined' ? employees : []).forEach(e => { %>
                                <option value="<%= e.id %>">
                                    <%= e.name %> (<%= e.designation || 'Employee' %>)
                                </option>
                            <% }) %>
                        </select>
                    </label>

                    <label class="full">
                        Routine Task title
                        <input name="title" placeholder="e.g. Daily Standup & Progress Log" required>
                    </label>

                    <label class="full">
                        <span>Description</span>
                        <textarea name="description" class="ck-editor-target" rows="3"></textarea>
                    </label>

                    <label>
                        Priority
                        <select name="priority">
                            <% ['Low','Medium','High','Critical'].forEach(x=>{ %>
                                <option <%= x === 'High' ? 'selected' : '' %>><%= x %></option>
                            <% }) %>
                        </select>
                    </label>

                    <label>
                        Daily Trigger Time
                        <input type="time" name="daily_time" value="09:00" required>
                    </label>

                    <label>
                        Repeat Schedule
                        <select name="repeat_type">
                            <option value="Daily">Daily (Everyday)</option>
                            <option value="Mon-Fri">Monday to Friday</option>
                        </select>
                    </label>

                    <label>
                        Estimated Hours / Day
                        <input type="number" name="estimated_hours" min="0" step="0.5" placeholder="e.g. 1.0">
                    </label>

                    <label>
                        Start Date
                        <input type="date" name="start_date" required>
                    </label>

                    <label>
                        End Date
                        <input type="date" name="end_date" required>
                    </label>

                    <div class="full actions" style="margin-top: 1rem;">
                        <button type="button" class="btn" data-close>
                            Cancel
                        </button>
                        <button class="btn primary">
                            <i class="fa-solid fa-check"></i> Assign Daily Routine Task
                        </button>
                    </div>

                </form>

            </div>
            <% } %>

        </div>

    </div>

    <script>
    document.querySelectorAll('.modal-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const modal = tab.closest('.modal-card');
            if (!modal) return;
            modal.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
            modal.querySelectorAll('.modal-tab-content').forEach(c => c.classList.remove('active'));
            tab.classList.add('active');
            const content = document.getElementById(tab.dataset.tab);
            if (content) content.classList.add('active');
        });
    });
    </script>

<% } %>

<%- include('partials/head',{title:project.name}) %>
<%- include('partials/nav',{page:'projects'}) %>

<% if(success){ %>
    <div class="success-toast">
        <i class="fa-solid fa-circle-check"></i>
        <span><b>Update successful</b><small>Project update was saved and sent to admin.</small></span>
    </div>
<% } %>

<% const backUrl = user.role === 'admin' ? '/projects' : '/dashboard'; %>

<div class="page-head project-hero">
    <div class="project-hero-top">
        <h1><%= project.name %></h1>
        <% if (user.role === 'admin' || user.role === 'manager') { %>
            <button type="button" class="hero-icon-pen-btn" data-open="edit-project-modal" title="Edit Project">
                <i class="fa-solid fa-pen"></i>
            </button>
        <% } %>
    </div>
    
    <div class="project-hero-meta">
        <div>
            <small>Assigned By</small>
            <b><%= project.creator_name %></b>
        </div>
        <div>
            <small>Manager</small>
            <b><%= project.manager_name %></b>
        </div>
        <div>
            <small>Assigned On</small>
            <b><%= formatDate(project.created_at) %></b>
        </div>
        <div>
            <small>Start Date</small>
            <b><%= formatDate(project.start_date) %></b>
        </div>
        <div>
            <small>Due Date</small>
            <b><%= formatDate(project.end_date) %></b>
        </div>
        <div>
            <small>Status</small>
            <div>
                <span class="status-chip <%= project.is_overdue ? 'overdue' : String(project.status).toLowerCase().replaceAll(' ', '-') %>">
                    <%= project.is_overdue ? 'Overdue' : project.status %>
                </span>
            </div>
        </div>
    </div>
</div>

<% if (projectAssignees && projectAssignees.length > 1) { %>
<section class="panel" style="margin-top:10px">
    <h2>Assigned Managers</h2>
    <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:8px;">
        <% projectAssignees.forEach(pa => {
            const paStatus = (function(s) {
                const sv = String(s||'').trim();
                if(sv==='0'||sv==='pending') return 'Pending';
                if(sv==='1'||sv==='in progress') return 'In Progress';
                if(sv==='2'||sv==='completed') return 'Completed';
                if(sv==='3'||sv==='cancelled') return 'Cancelled';
                if(sv==='4'||sv==='planned') return 'Planned';
                return sv || 'Pending';
            })(pa.status_id ?? pa.status);
        %>
        <div style="display:flex; align-items:center; gap:8px; background:#f1f5f9; border-radius:10px; padding:8px 14px;">
            <div class="avatar" style="width:32px;height:32px;font-size:13px;flex-shrink:0;"><%= pa.name.charAt(0) %></div>
            <div>
                <div style="font-weight:700; font-size:13px; color:#0f172a;"><%= pa.name %></div>
                <span class="status-chip <%= String(paStatus).toLowerCase().replaceAll(' ','-') %>" style="font-size:10px; padding:2px 8px;">
                    <%= paStatus %>
                </span>
            </div>
        </div>
        <% }) %>
    </div>
</section>
<% } %>

<section class="panel" style="margin-top:10px">
    <h2>Project details</h2>
    <div class="description-content ck-content"><%- project.description || 'No detailed description provided.' %></div>
</section>

<section class="panel" style="margin-top:10px">
    <div class="panel-head">
        <h2>Manager daily updates</h2>
    </div>
    <div class="comments" style="max-height: 280px; overflow-y: auto; padding-right: 4px;">
        <% updates.forEach(x=>{ %>
            <article>
                <div class="avatar"><%= x.manager_name.charAt(0) %></div>
                <div>
                    <header>
                        <b><%= x.manager_name %> · <%= x.progress_percent %>% complete</b>
                        <time><%= formatDateTime(x.created_at) %></time>
                    </header>
                    <p><%= x.message %></p>
                </div>
            </article>
        <% }) %>
        <% if(!updates.length){ %>
            <p class="muted">No manager updates yet.</p>
        <% } %>
    </div>
</section>

<% if(user.role==='manager'){ %>
    <section class="panel" style="margin-top:10px">
        <h2>Add daily project update</h2>
        <p class="muted" style="text-align:left">Tell the admin what was completed today and the current overall progress.</p>
        <form action="/projects/<%= project.id %>/updates" method="post" class="form-grid">
            <label class="full">
                Today's completed work / update
                <textarea name="message" rows="4" required placeholder="Example: Product listing page completed, Amazon account verification is pending..."></textarea>
            </label>
            <label>
                Overall progress (%)
                <input type="number" name="progress_percent" min="0" max="100" required>
            </label>
            <div class="actions">
                <button class="btn primary">Send update to admin</button>
            </div>
        </form>
    </section>
<% } %>

<% if(user.role==='admin' || user.role==='manager'){ %>
    <section class="panel" style="margin-top:10px">
        <div class="panel-head">
            <h2>Project tasks</h2>
        </div>
        <div class="table-wrap" style="max-height: 180px; overflow-y: auto; overflow-x: auto;">
            <table>
                <thead style="position: sticky; top: 0; background: #edf2fa; z-index: 2;">
                    <tr>
                        <th>Task</th>
                        <th>Employee</th>
                        <th>Assigned on</th>
                        <th>Due date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% tasks.forEach(t=>{ %>
                        <tr>
                            <td><a href="/tasks/<%= t.id %>"><b><%= t.title %></b></a></td>
                            <td><%= t.employee_name %></td>
                            <td><%= formatDate(t.created_at) %></td>
                            <td><%= formatDate(t.due_date) %></td>
                            <td><span class="status-chip <%= t.status.toLowerCase().replaceAll(' ', '-') %>"><%= t.status %></span></td>
                        </tr>
                    <% }) %>
                    <% if(!tasks.length){ %>
                        <tr><td colspan="5" class="empty">No tasks assigned to this project yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
<% } %>

<% if (user.role === 'admin' || user.role === 'manager') { %>
<div class="modal" id="edit-project-modal">
    <div class="modal-card">
        <button class="modal-close" data-close>&times;</button>
        <h2>Edit Project Details</h2>
        <form action="/projects" method="post" class="form-grid">
            <input type="hidden" name="id" value="<%= project.id %>">
            <label class="full">Project name
                <input name="name" value="<%= project.name %>" required>
            </label>
            <label class="full">
                <span>Full project details</span>
                <textarea name="description" class="ck-editor-target" rows="5"><%= project.description || '' %></textarea>
            </label>
            <label>Start date
                <input type="date" name="start_date" value="<%= project.start_date ? new Date(project.start_date).toISOString().split('T')[0] : '' %>" required>
            </label>
            <label>Due date
                <input type="date" name="end_date" value="<%= project.end_date ? new Date(project.end_date).toISOString().split('T')[0] : '' %>" required>
            </label>
            <% if (user.role === 'admin') { %>
                <label class="full">Assign manager
                    <select name="manager_id" required>
                        <% (typeof managers !== 'undefined' ? managers : []).forEach(m => { %>
                            <option value="<%= m.id %>" <%= project.manager_id === m.id ? 'selected' : '' %>><%= m.name %></option>
                        <% }) %>
                    </select>
                </label>
            <% } else { %>
                <input type="hidden" name="manager_id" value="<%= project.manager_id %>">
            <% } %>
            <div class="full actions">
                <button type="button" class="btn" data-close>Cancel</button>
                <button class="btn primary">Save Project Changes</button>
            </div>
        </form>
    </div>
</div>
<% } %>

<%- include('partials/foot') %>

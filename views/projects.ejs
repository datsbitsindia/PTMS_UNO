<%- include('partials/head',{title:'Projects'}) %><%- include('partials/nav',{page:'projects'}) %>
<div class="toolbar-ui compact-filter"><input type="search" placeholder="Search projects..."><select><option>All Status</option><option>Planned</option><option>In Progress</option><option>Completed</option><option>Cancelled</option></select><button type="button" class="filter-confirm"><i class="fa-solid fa-check"></i> Confirm</button></div>
<section class="ui-panel"><div class="ui-panel-head"><h2>My Projects</h2></div><div class="entity-list"><% projects.forEach(p=>{ %><article class="entity-card project-card" data-status="<%= p.status %>" onclick="window.location.href='/projects/<%= p.id %>'" style="cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:12px 16px; gap:12px; grid-template-columns:none!important;"><div class="entity-title" style="flex:1; min-width:0;"><div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:2px;"><a href="/projects/<%= p.id %>" style="font-weight:800; font-size:15px; color:#0f172a; text-decoration:none;" onclick="event.stopPropagation();"><%= p.name %></a><span class="status-chip <%= String(p.status).toLowerCase().replaceAll(' ','-') %>"><%= p.status %></span></div><small style="color:#64748b; font-size:11px;"><%= p.description ? p.description.substring(0, 80) + '...' : 'No description' %></small></div><div style="display:flex; align-items:center; gap:6px; flex-shrink:0;" onclick="event.stopPropagation();"><a class="entity-action open-project-btn" href="/projects/<%= p.id %>" style="display:inline-flex; align-items:center; gap:6px; padding:6px 12px; width:auto; height:32px; border-radius:8px; background:#d3e3fd; color:#0b2d68; font-size:12px; font-weight:700; text-decoration:none; white-space:nowrap;">View <i class="fa-solid fa-arrow-right"></i></a><% if(user.role==='admin'){ %><form method="post" action="/projects/<%= p.id %>/delete" onsubmit="return confirm('Delete project <%= p.name %>?');" style="margin:0;display:inline;"><button class="btn btn-sm danger-btn" style="height:32px; padding:4px 10px; border-radius:8px; font-size:12px;"><i class="fa-solid fa-trash"></i></button></form><% } %></div></article><% }) %><% if(!projects.length){ %><p class="empty">No projects found.</p><% } %></div></section>
<% if(user.role==='admin'){ %><div class="modal" id="project-modal"><div class="modal-card"><button class="modal-close" data-close>&times;</button><h2>Create project</h2><form method="post" action="/projects" class="form-grid"><label class="full">Project name<input name="name" required></label><label class="full"><div style="display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:4px"><span>Full project details</span><div class="textarea-toolbar"><button type="button" class="btn-xs-tool" onclick="insertBullet(this.closest('label').querySelector('textarea'),0)" title="Add bullet point"><i class="fa-solid fa-list-ul"></i> Bullet</button><button type="button" class="btn-xs-tool" onclick="insertBullet(this.closest('label').querySelector('textarea'),1)" title="Add sub-bullet point"><i class="fa-solid fa-indent"></i> Sub-bullet</button></div></div><textarea name="description" rows="3" required></textarea></label><input type="hidden" name="manager_id" value="<%= user.id %>"><div class="full actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn primary">Create project</button></div></form></div></div><% } %><%- include('partials/foot') %>

<%- include('partials/head',{title:'Projects'}) %><%- include('partials/nav',{page:'projects'}) %>

<%
    const totalProjectsCount = projects.length;
    const plannedProjectsCount = projects.filter(p => String(p.status).toLowerCase() === 'planned').length;
    const inProgressProjectsCount = projects.filter(p => String(p.status).toLowerCase() === 'in progress').length;
    const completedProjectsCount = projects.filter(p => String(p.status).toLowerCase() === 'completed').length;
    const overdueProjectsCount = projects.filter(p => p.is_overdue).length;
%>

<div class="metrics-grid compact-kpi-grid" style="margin-bottom: 14px;">
    <div class="metric-card" onclick="filterByKpi('all', event)" style="cursor: pointer;">
        <i class="fa-solid fa-folder-open icon"></i>
        <div>
            <strong><%= totalProjectsCount %></strong>
            <span>Total Projects</span>
        </div>
    </div>
    <div class="metric-card" onclick="filterByKpi('planned', event)" style="cursor: pointer;">
        <i class="fa-solid fa-clock icon" style="color: #ea580c;"></i>
        <div>
            <strong><%= plannedProjectsCount %></strong>
            <span>Planned</span>
        </div>
    </div>
    <div class="metric-card" onclick="filterByKpi('in progress', event)" style="cursor: pointer;">
        <i class="fa-solid fa-spinner icon" style="color: #2563eb;"></i>
        <div>
            <strong><%= inProgressProjectsCount %></strong>
            <span>In Progress</span>
        </div>
    </div>
    <div class="metric-card" onclick="filterByKpi('completed', event)" style="cursor: pointer;">
        <i class="fa-solid fa-circle-check icon" style="color: #16a34a;"></i>
        <div>
            <strong><%= completedProjectsCount %></strong>
            <span>Completed</span>
        </div>
    </div>
    <div class="metric-card" onclick="filterByKpi('overdue', event)" style="cursor: pointer;">
        <i class="fa-solid fa-triangle-exclamation icon" style="color: #dc2626;"></i>
        <div>
            <strong><%= overdueProjectsCount %></strong>
            <span>Overdue</span>
        </div>
    </div>
</div>

<div class="toolbar-ui compact-filter"><input type="search" placeholder="Search projects..."><select><option>All Status</option><option>Planned</option><option>In Progress</option><option>Completed</option><option>Cancelled</option></select><button type="button" class="filter-confirm"><i class="fa-solid fa-check"></i> Confirm</button></div>

<% const overdueProjects=projects.filter(p=>p.is_overdue); %><% if(overdueProjects.length){ %><div class="overdue-alert"><i class="fa-solid fa-triangle-exclamation"></i><div><b><%= overdueProjects.length %> overdue project<%= overdueProjects.length>1?'s':'' %></b><span><%= user.role==='admin'?'The manager has been notified. Please review progress.':'Due date has passed. Send an urgent update to admin.' %></span></div></div><% } %><section class="ui-panel"><div class="ui-panel-head"><h2><%= user.role==='admin'?'My Projects':'Assigned Projects' %></h2></div><div class="entity-list"><% projects.forEach(p=>{ %><article class="entity-card project-card <%= p.is_overdue?'overdue-card':'' %>" data-status="<%= p.status %>" onclick="window.location.href='/projects/<%= p.id %>'" style="cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:9px 14px; gap:10px; grid-template-columns:none!important;"><div class="entity-title" style="flex:1; min-width:0;"><div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:2px;"><a href="/projects/<%= p.id %>" style="font-weight:800; font-size:15px; color:#0f172a; text-decoration:none;" onclick="event.stopPropagation();"><%= p.name %></a><span class="status-chip <%= p.is_overdue?'overdue':String(p.status).toLowerCase().replaceAll(' ','-') %>"><%= p.is_overdue?'Overdue':p.status %></span></div><small style="color:#64748b; font-size:11px;">Managed by <b><%= p.manager_name %></b></small></div><div class="project-inline-dates" style="display:flex; flex-direction:column; align-items:flex-end; gap:2px; font-size:10.5px; color:#475569; flex-shrink:0; text-align:right;"><span><i class="fa-regular fa-calendar" style="color:#3b68b7;"></i> <b>Start:</b> <%= formatDate(p.start_date) %></span><span><i class="fa-regular fa-calendar-check" style="color:#16a34a;"></i> <b>Due:</b> <%= formatDate(p.end_date) %></span></div></article><% }) %><% if(!projects.length){ %><p class="empty">No projects found.</p><% } %></div></section>
<% if(user.role==='admin'){ %><div class="modal" id="project-modal"><div class="modal-card"><button class="modal-close" data-close>&times;</button><h2>Create project</h2><form method="post" action="/projects" class="form-grid"><label class="full">Project name<input name="name" required></label><label class="full"><span>Full project details</span><textarea name="description" class="ck-editor-target" rows="3"></textarea></label><label>Start date<input type="date" name="start_date" required></label><label>Due date<input type="date" name="end_date" required></label><label class="full"><span>Assign Managers (Select Multiple)</span><div class="multi-assignee-picker"><div class="assignees-chips-list" id="project-manager-chips"></div><select class="assignee-select-dropdown" onchange="addAssigneeChip(this, 'project-manager-chips', 'manager_id')">
<option value="">+ Select Manager to add...</option><% managers.forEach(m=>{ %><option value="<%= m.id %>" data-name="<%= m.name %>" data-role="Manager"><%= m.name %> (<%= m.designation || 'Manager' %>)</option><% }) %></select></div></label><div class="full actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn primary">Assign project</button></div></form></div></div><% } %><%- include('partials/foot') %>

